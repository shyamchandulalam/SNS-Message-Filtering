# Flask Secret Key
SECRET_KEY=sns-filterhub-production-key-change-me

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:541645813476:order-events-topic

# Operation Mode: auto, real, simulation
# auto: attempts AWS SNS publish, gracefully falls back to local high-fidelity simulation if AWS is unreachable or credentials absent
OPERATION_MODE=auto

# Database Path (defaults to local SQLite sns_filterhub.db)
DATABASE_URL=
